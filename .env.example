# ═══════════════════════════════════════════════════════════════
# CoreTracker — Template de Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════════
# Copie este arquivo para .env.development ou .env.production
# e preencha os valores.

# ─── Mock System ─────────────────────────────────────────────
VITE_USE_MOCKS=true              # true = usar mocks, false = usar serviços reais
VITE_DEV_TOOLBAR=true            # Exibir toolbar de debug
VITE_MOCK_DELAY_MS=400           # Latência simulada em ms
VITE_SIMULATE_FAILURES=false     # Simular falhas aleatórias
VITE_FAILURE_RATE=0.1            # Taxa de falha (0-1) quando simulação ativada
VITE_VERBOSE_LOGGING=true        # Logs detalhados no console

# ─── Service Overrides (modo híbrido) ────────────────────────
# VITE_AUTH_PROVIDER=mock        # "mock" ou "real"
# VITE_STORAGE_PROVIDER=mock     # "mock" ou "real"
# VITE_EXERCISE_API_PROVIDER=mock # "mock" ou "real"

# ─── Supabase ────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
